# Compose publishes the public API on this host address and port.
# For a reverse proxy running on the VPS host, set ROUTE_FINDER_BIND=127.0.0.1.
ROUTE_FINDER_BIND=0.0.0.0
ROUTE_FINDER_PORT=8000
ROUTE_FINDER_MEMORY_LIMIT=512m

# Lower cache capacity for a 2 GB VPS. Randomized plans do not use the cache.
CACHE_SIZE=32
CORS_ALLOW_ORIGINS=*
# Example: CORS_ALLOW_ORIGINS=https://your-frontend.example,http://localhost:5173
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot

# Enable only with real routing backends implementing these restrictions.
# OSRM_STEP_FREE_BASE_URL=https://your-step-free-router.example
# OSRM_WHEELCHAIR_BASE_URL=https://your-wheelchair-router.example
