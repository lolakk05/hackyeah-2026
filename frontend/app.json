{
  "expo": {
    "name": "Spacer.io",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/spacer-icon.png",
    "scheme": "spacerio",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/spacer-icon.png",
      "bundleIdentifier": "com.hackyeah.krakowquest"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16233A",
        "foregroundImage": "./assets/images/spacer-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hackyeah.krakowquest"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1724",
          "image": "./assets/images/spacer-splash.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Spacer.io uses your location to guide you to the next stop on your route."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
