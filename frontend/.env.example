# ─────────────────────────────────────────────────────────────
#  Spacer.io – environment settings (example)
#  Copy this file to .env and change the address:
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Address of the Route Finder backend.
#  • Use your computer's LAN IP address, not localhost / 127.0.0.1
#    (the phone is a different device). On a Mac:  ipconfig getifaddr en0
#  • Start the backend so other devices can reach it:
#      uvicorn … --host 0.0.0.0 --port 8000
#  • The phone and the computer must be on the same Wi-Fi.
#  • Leave it empty or commented out to use the built-in sample data.
EXPO_PUBLIC_API_URL=http://192.168.0.12:8000

# Account server: sign-in, XP, coins, ranking and rewards.
# It can be the same address as above. Leave it commented out to use
# demo accounts saved on the phone.
# EXPO_PUBLIC_ACCOUNT_API_URL=http://192.168.0.12:8000

# Sign-in server (Better Auth). Leave commented out for demo accounts on the phone.
# EXPO_PUBLIC_AUTH_API_URL=http://192.168.0.12:3000

# After changing this file:
#  • Expo Go / dev build:  npx expo start -c
#  • Release build: rebuild the app (the address is baked in at build time).
